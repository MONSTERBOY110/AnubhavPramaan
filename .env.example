# Copy to .env.local and fill in. Never commit real values.

# Bhashini (ULCA pipeline) for Hindi ASR, translation and TTS. Keys from the Bhashini portal
# ("API Key Repository") after the hackathon key request is approved.
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_INFERENCE_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# Development stand-ins while the Bhashini key is pending (labelled as stand-ins in the UI; for
# development and role-play audio only, never real worker data): ElevenLabs Scribe v2 for Hindi
# speech recognition and Flash v2.5 for Hindi speech (clips cached in .cache/tts/).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Groq Whisper (whisper-large-v3): the automatic fallback recogniser behind the ElevenLabs
# stand-in. Speech only; no text model is used on Groq.
GROQ_API_KEY=

# Azure AI Foundry: the text model for claim extraction and PC linking, and the image model for
# evidence hints. OpenAI-compatible v1 endpoint, for example https://<resource>.services.ai.azure.com/openai/v1
# Without these, extraction falls back to rules, mapping to the keyword baseline, and hints say
# they are unavailable. Optional: LLM_TIMEOUT_MS (default 60000).
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini

# Record store (Upstash Redis). Leave empty for the in-memory dev store.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Public base URL used inside records and QR codes.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Development only: lets /record save role-play recordings under docs/internal/recordings.
# AP_DEV_RECORDINGS=1
